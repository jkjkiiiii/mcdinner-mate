# ============================================================
# 复制为 .env 后填写真实值。
# ⚠️ 本文件只保留占位符，提交到公开仓库是安全的。
#    .env（含真实 Token / 手机号）已被 .gitignore 屏蔽，严禁提交。
# ============================================================

# ---------- 麦当劳 MCP（必需）----------
# 申请：open.mcd.cn/mcp → 手机号登录 → 控制台 → 激活（免费）
MCP_TOKEN={{MCP_TOKEN}}
# 官方写 https://mcp.mcd.cn；仓库示例为 /mcp-servers/mcd-mcp，二选一实测
MCP_SERVER_URL=https://mcp.mcd.cn

# ---------- 大模型 ----------
# 默认使用本地 vLLM（OpenAI 兼容接口）；也可换成 Kimi / DeepSeek 等云端
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY={{LLM_API_KEY}}
LLM_MODEL={{LLM_MODEL}}

# ---------- 麦当劳账号（测试用，个人信息，勿提交）----------
TEST_PHONE={{TEST_PHONE}}
DEFAULT_STORE_ID={{DEFAULT_STORE_ID}}
DELIVERY_ADDRESS={{DELIVERY_ADDRESS}}
LAT={{LAT}}
LON={{LON}}

# ---------- 语音 ----------
# ASR 本地方案（faster-whisper，需 NVIDIA GPU），无需 API Key
ASR_MODEL=large-v3
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
# TTS 用 edge-tts，无需 Key
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---------- 人设 ----------
# gentle = 温柔树洞（默认，规避"讽刺贬低品牌"合规红线）
# sarcastic = 毒舌麦门信徒（只允许吐槽工作/生活，禁止吐槽麦当劳）
PORTRAIT_MODE=gentle
